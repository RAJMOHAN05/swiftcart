{
  "name": "SwiftCart Premium",
  "short_name": "SwiftCart",
  "id": "/",
  "description": "A clean, smart and installable shopping experience.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f5f7ff",
  "theme_color": "#4f46e5",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/static/images/pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/static/images/pwa-icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {"name": "Shop", "url": "/shop/", "icons": [{"src": "/static/images/pwa-icon.svg", "sizes": "192x192", "type": "image/svg+xml"}]},
    {"name": "My Orders", "url": "/orders/history/", "icons": [{"src": "/static/images/pwa-icon.svg", "sizes": "192x192", "type": "image/svg+xml"}]}
  ]
}
