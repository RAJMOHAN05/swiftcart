DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DB_ENGINE=sqlite

# PostgreSQL settings used when DB_ENGINE=postgres
POSTGRES_DB=swiftcart
POSTGRES_USER=swiftcart
POSTGRES_PASSWORD=swiftcart_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Console backend prints email locally. Replace with SMTP values in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL="SwiftCart <orders@example.com>"
SUPPORT_EMAIL=support@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
SITE_URL=http://127.0.0.1:8000
